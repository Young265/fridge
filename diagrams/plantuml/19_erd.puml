@startuml
title 개념 ERD
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName "Malgun Gothic"
skinparam defaultFontSize 15
skinparam ArrowColor #49657A
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #49657A
}

entity "users" as users #E8F2FF
entity "fridges" as fridges #EAF7EE
entity "fridge_items" as fridge_items #FFF4D9
entity "ingredients" as ingredients #EAF7EE
entity "recipes" as recipes #FFECEC
entity "recipe_ingredients" as recipe_ingredients #F3ECFF

users ||--o{ fridges
fridges ||--o{ fridge_items
ingredients |o--o{ fridge_items
recipes ||--o{ recipe_ingredients
ingredients ||--o{ recipe_ingredients
@enduml
